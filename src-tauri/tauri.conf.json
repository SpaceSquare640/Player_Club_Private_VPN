{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Player Club Private VPN",
  "version": "0.42.1",
  "identifier": "com.playerclub.privatevpn",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Player Club Private VPN",
        "width": 1100,
        "height": 680,
        "minWidth": 900,
        "minHeight": 560,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "resources": [
      "resources/wintun/**/*"
    ],
    "shortDescription": "Gaming Virtual Network",
    "longDescription": "Player Club Private VPN creates secure, low-latency virtual LANs for multiplayer gaming.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
